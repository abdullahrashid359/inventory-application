<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit <%= developer.name %> - GameVault</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="main-content">
        <div class="page-header">
            <h1 class="page-title">Edit Developer</h1>
        </div>

        <% if (locals.errors && locals.errors.length > 0) { %>
            <div class="form-errors">
                <ul>
                    <% locals.errors.forEach(error => { %>
                        <li><%= error.msg %></li>
                    <% }) %>
                </ul>
            </div>
        <% } %>

        <form class="form" action="/developers/<%= id %>/edit" method="POST">
            <div class="form-group">
                <label for="name">Developer Name</label>
                <input
                    type="text"
                    id="name"
                    name="name"
                    value="<%= developer.name %>"
                    required
                >
            </div>

            <div class="form-actions">
                <a
                    class="button button-secondary"
                    href="/developers/<%= id %>"
                >
                    Cancel
                </a>

                <button class="button" type="submit">
                    Save Changes
                </button>
            </div>
        </form>
    </main>
</body>
</html>