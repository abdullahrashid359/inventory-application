<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Game - GameVault</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="main-content">
        <div class="page-header">
            <h1 class="page-title">Add Game</h1>
        </div>

        <% if (locals.errors && locals.errors.length > 0) { %>
            <div class="form-errors">
                <ul>
                    <% locals.errors.forEach(error => { %>
                        <li><%= error.msg %></li>
                    <% }) %>
                </ul>
            </div>
        <% } %>

        <form class="form" action="/games/new" method="POST">

            <div class="form-group">
                <label for="title">Title</label>
                <input
                    type="text"
                    id="title"
                    name="title"
                    value="<%= locals.formData?.title || '' %>"
                    required
                >
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea
                    id="description"
                    name="description"
                    rows="5"
                ><%= locals.formData?.description || '' %></textarea>
            </div>

            <div class="form-group">
                <label for="price">Price</label>
                <input
                    type="number"
                    id="price"
                    name="price"
                    min="0"
                    step="0.01"
                    value="<%= locals.formData?.price || '' %>"
                    required
                >
            </div>

            <div class="form-group">
                <label for="rating">Rating</label>
                <input
                    type="number"
                    id="rating"
                    name="rating"
                    min="0"
                    max="10"
                    step="0.1"
                    value="<%= locals.formData?.rating || '' %>"
                >
            </div>

            <fieldset class="form-group">
                <legend>Genres</legend>

                <% genres.forEach(genre => { %>
                    <label class="checkbox-label">
                        <input
                            type="checkbox"
                            name="genres"
                            value="<%= genre.id %>"
                            <%= Array.isArray(locals.formData?.genres) &&
                                locals.formData.genres.includes(String(genre.id))
                                ? 'checked'
                                : '' %>
                        >
                        <%= genre.name %>
                    </label>
                <% }) %>
            </fieldset>

            <fieldset class="form-group">
                <legend>Developers</legend>

                <% developers.forEach(developer => { %>
                    <label class="checkbox-label">
                        <input
                            type="checkbox"
                            name="developers"
                            value="<%= developer.id %>"
                            <%= Array.isArray(locals.formData?.developers) &&
                                locals.formData.developers.includes(String(developer.id))
                                ? 'checked'
                                : '' %>
                        >
                        <%= developer.name %>
                    </label>
                <% }) %>
            </fieldset>

            <div class="form-actions">
                <a class="button button-secondary" href="/games">
                    Cancel
                </a>

                <button class="button" type="submit">
                    Add Game
                </button>
            </div>

        </form>
    </main>
</body>
</html>