<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Developer - GameVault</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="main-content">
        <div class="page-header">
            <h1 class="page-title">Add Developer</h1>
        </div>

        <form class="form" action="/developers/new" method="POST">
            <div class="form-group">
                <label for="name">Developer Name</label>
                <input type="text" id="name" name="name" required>
            </div>

            <div class="form-actions">
                <a class="button button-secondary" href="/developers">
                    Cancel
                </a>

                <button class="button" type="submit">
                    Add Developer
                </button>
            </div>
        </form>
    </main>
</body>
</html>