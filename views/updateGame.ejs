<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit <%= game.title %> - GameVault</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="main-content">
        <div class="page-header">
            <h1 class="page-title">Edit Game</h1>
        </div>

        <% if (locals.errors && locals.errors.length > 0) { %>
            <div class="form-errors">
                <ul>
                    <% locals.errors.forEach(error => { %>
                        <li><%= error.msg %></li>
                    <% }) %>
                </ul>
            </div>
        <% } %>

        <form class="form" action="/games/<%= game.id %>/edit" method="POST">

            <div class="form-group">
                <label for="title">Title</label>
                <input
                    type="text"
                    id="title"
                    name="title"
                    value="<%= game.title %>"
                    required
                >
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea
                    id="description"
                    name="description"
                    rows="5"
                ><%= game.description || '' %></textarea>
            </div>

            <div class="form-group">
                <label for="price">Price</label>
                <input
                    type="number"
                    id="price"
                    name="price"
                    value="<%= game.price %>"
                    min="0"
                    step="0.01"
                    required
                >
            </div>

            <div class="form-group">
                <label for="rating">Rating</label>
                <input
                    type="number"
                    id="rating"
                    name="rating"
                    value="<%= game.rating ?? '' %>"
                    min="0"
                    max="10"
                    step="0.1"
                    required
                >
            </div>

            <fieldset class="form-group">
                <legend>Genres</legend>

                <% genres.forEach(genre => { %>
                    <label class="checkbox-label">
                        <input
                            type="checkbox"
                            name="genres"
                            value="<%= genre.id %>"
                            <%= game.genres.some(
                                gameGenre => gameGenre.name === genre.name
                            ) ? 'checked' : '' %>
                        >
                        <%= genre.name %>
                    </label>
                <% }) %>
            </fieldset>

            <fieldset class="form-group">
                <legend>Developers</legend>

                <% developers.forEach(developer => { %>
                    <label class="checkbox-label">
                        <input
                            type="checkbox"
                            name="developers"
                            value="<%= developer.id %>"
                            <%= game.developers.some(
                                gameDeveloper => gameDeveloper.name === developer.name
                            ) ? 'checked' : '' %>
                        >
                        <%= developer.name %>
                    </label>
                <% }) %>
            </fieldset>

            <div class="form-actions">
                <a
                    class="button button-secondary"
                    href="/games/<%= game.id %>"
                >
                    Cancel
                </a>

                <button class="button" type="submit">
                    Save Changes
                </button>
            </div>

        </form>
    </main>
</body>
</html>