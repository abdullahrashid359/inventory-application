<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Genres - GameVault</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="main-content">
        <div class="page-header">
            <h1 class="page-title">Genres</h1>
            <a class="button" href="/genres/new">Add Genre</a>
        </div>

        <section class="category-list">
            <% genres.forEach(genre => { %>
                <article class="category-card">
                    <h2 class="category-card-title">
                        <a href="/genres/<%= genre.id %>">
                            <%= genre.name %>
                        </a>
                    </h2>

                    <div class="category-card-actions">
                        <a class="button button-small" href="/genres/<%= genre.id %>">
                            View
                        </a>

                        <a
                            class="button button-small button-secondary"
                            href="/genres/<%= genre.id %>/edit"
                        >
                            Edit
                        </a>

                        <form
                            action="/genres/<%= genre.id %>/delete"
                            method="POST"
                            onsubmit="return confirm('Are you sure you want to delete this genre?');"
                        >
                            <button
                                class="button button-small button-danger"
                                type="submit"
                            >
                                Delete
                            </button>
                        </form>
                    </div>
                </article>
            <% }) %>
        </section>
    </main>
</body>
</html>